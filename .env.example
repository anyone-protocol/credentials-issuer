# Issuer service
PORT=3000

# Bundle parameters. BUNDLE_SIZE (k) and the blob sizes are provisional until
# the 0.3 credential spec lands. See README.
BUNDLE_SIZE=10
BLANK_SIZE_BYTES=256
SIGNATURE_SIZE_BYTES=256
KEY_DOCUMENT_PATH=config/keys/current.json

# Postgres (TypeORM)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# See README for both of these.
# DB_SYNCHRONIZE=true
# DB_MIGRATIONS_RUN=true

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
