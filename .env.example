# Issuer service
PORT=3000

# Bundle parameters. BUNDLE_SIZE (k) and the blob sizes are provisional until
# the 0.3 credential spec lands. See README.
BUNDLE_SIZE=10
BLANK_SIZE_BYTES=256
SIGNATURE_SIZE_BYTES=256
# Epoch keyring: every usable epoch key plus the published documents. Generate
# with `bun run keys:dev`; rendered from Vault in stage and live. See README.
KEYRING_PATH=config/keys/keyring.json
# How often the keyring file is re-read, so a rotation lands without a restart.
KEYRING_RELOAD_SECONDS=30
# Fronting proxy's Ed25519 public key (SPKI PEM). proxy_sig is verified against
# it, so the issuer will not sign for a claim this key did not sign.
PROXY_PUBLIC_KEY_PATH=config/keys/proxy.pub.pem
# Price of one bundle, exact decimal. A claim must match it.
BUNDLE_PRICE=1.00
# How often the reconciliation job compares the epoch counters.
RECONCILIATION_INTERVAL_SECONDS=60
# Blind-signing worker threads. 0 signs inline on the main thread and starts no
# threads at all, which is slower but simpler to run and debug. See README.
SIGNING_WORKERS=4
# Use the OpenSSL-backed RSA-RAW fast path (~420x faster). false forces the
# library's pure-JS path. See README.
SIGNING_NATIVE_RSA=true
# Bounds one signing task. Raise it if forcing the pure-JS path.
SIGNING_TIMEOUT_MS=10000

# Rate limit, per payment_ref and never per IP (I5).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# Postgres (TypeORM)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# See README for both of these.
# DB_SYNCHRONIZE=true
# DB_MIGRATIONS_RUN=true

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
